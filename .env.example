# Copy to .env and fill in real values. Never commit .env.

# HTTP port the service listens on.
PORT=8080

# ── /api/v1 authentication ────────────────────────────────────────────────────
# Static shared secret the AppBox client sends as X-AppBox-Client-Token.
APPBOX_CLIENT_TOKEN=change-me

# ── Dropbox ──────────────────────────────────────────────────────────────────
# Public OAuth client_id served by GET /api/v1/config.
DROPBOX_APP_KEY=your-dropbox-app-key
# Seconds a verified Dropbox access token stays cached before re-verification.
DROPBOX_TOKEN_CACHE_TTL_SECONDS=600

# ── Mailgun (POST /api/v1/mail/send) ─────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.example.com
MAILGUN_FROM="AppBox Build <build@example.com>"

# ── YOURLS short links (POST /api/v1/shorten) ────────────────────────────────
YOURLS_API_URL=https://example.com/yourls-api.php
YOURLS_SIGNATURE_SECRET=
# The installer web page the shortened link points at.
SHORTLINK_TARGET_BASE=https://web.example.com

# ── /cors proxy allowlist ────────────────────────────────────────────────────
# Comma-separated host suffixes /cors?url= may proxy to (exact host or subdomain).
CORS_PROXY_ALLOWED_HOSTS=dropbox.com,dropboxusercontent.com,getappbox.com
# Max bytes buffered from one proxied upstream response (manifest/appinfo are KB-sized).
PROXY_MAX_BODY_BYTES=4194304

# ── Update check (GET /api/v1/latest-version) ────────────────────────────────
# Upstreams merged + cached so clients don't hit GitHub directly (rate limits).
GITHUB_LATEST_RELEASE_URL=https://api.github.com/repos/getappbox/AppBox-iOSAppsWirelessInstallation/releases/latest
HOMEBREW_CASK_URL=https://formulae.brew.sh/api/cask/appbox.json
UPDATE_CACHE_TTL_SECONDS=3600

# ── Notify (POST /api/v1/notify) ─────────────────────────────────────────────
# Host suffixes an incoming webhook may be POSTed to (Slack / Teams).
# office.com + office365.com = retired Office 365 connectors; logic.azure.com +
# powerplatform.com = their replacement, Teams Workflows (Power Automate).
NOTIFY_ALLOWED_HOSTS=hooks.slack.com,office.com,office365.com,logic.azure.com,powerplatform.com

# ── Rate limiting ────────────────────────────────────────────────────────────
# How many reverse proxies in front of this service append to X-Forwarded-For.
# Set to 0 when nothing fronts the service, to ignore the header entirely.
TRUSTED_PROXY_COUNT=1
